# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=broadway_pm
DB_SYNCHRONIZE=true
DB_SSL=false
DB_MIGRATIONS_RUN=false

# Security (REQUIRED in production — 32+ random chars each)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_change_in_production_min_32_chars
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001
APP_URL=http://localhost:3001
PAYMENT_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS — Africa's Talking (recommended for Rwanda MTN/Airtel)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# SMS / WhatsApp — Twilio (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp custom webhook (optional BSP)
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=

# OAuth
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# Stripe subscription billing (Broadway SaaS fees)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=

# Payment gateways (when bank/MoMo partners approve — still placeholder checkout until keys added)
MTN_MOMO_API_KEY=
AIRTEL_MONEY_API_KEY=
